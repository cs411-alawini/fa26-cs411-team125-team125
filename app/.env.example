# Copy this file to .env and fill in your values. Never commit .env.

# Cloud SQL public IP (GCP Console -> SQL -> your instance -> Overview)
DB_HOST=34.23.191.95
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=cs411_project

# SSL: "required" encrypts the connection (same as mysql --ssl-mode=REQUIRED).
# "verify" also checks the server certificate; set DB_SSL_CA to the server-ca.pem
# you download from the instance's Connections -> Security page.
# "off" is only for a local MySQL with no SSL.
DB_SSL=required
# DB_SSL_CA=./server-ca.pem

# Which user the app acts as until login is built (any Users.user_id).
# Leave empty to use the lowest user_id in the table.
DEFAULT_USER_ID=

PORT=3000
